# BarbaroTech local environment example
# Copy to .env.local for local frontend testing or .env for local backend scripts.
# Do not commit real secrets, database URLs, Stripe keys, SMTP passwords, or AWS credentials.

# Public marketing/contact values
NEXT_PUBLIC_TEXT_EMAIL="6195362504@vtext.com"
NEXT_PUBLIC_CONTACT_INTAKE_ENABLED="true"

# SMTP for /api/contact and /api/call-request
SMTP_HOST="smtp-relay.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
CONTACT_FROM="BarbaroTech Contact <no-reply@barbaro.tech>"
CONTACT_TO="anthony@barbaro.tech"
CALL_TO="anthony@barbaro.tech"
SES_FROM_EMAIL="anthony@barbaro.tech"

# Public portal frontend config
# These are safe to expose in the static frontend because they are NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL="https://your-api-id.execute-api.us-west-1.amazonaws.com"
NEXT_PUBLIC_ADMIN_EMAIL="anthony@barbaro.tech"
NEXT_PUBLIC_COGNITO_DOMAIN="https://your-domain.auth.us-west-1.amazoncognito.com"
NEXT_PUBLIC_COGNITO_CLIENT_ID="your-public-cognito-app-client-id"
NEXT_PUBLIC_COGNITO_REDIRECT_URI="http://localhost:3000/auth/callback/"
NEXT_PUBLIC_COGNITO_LOGOUT_URI="http://localhost:3000/"

# Server-only local development values
# Keep these out of frontend code. In AWS, prefer Secrets Manager or SSM Parameter Store.
DATABASE_URL="postgresql://user:password@your-railway-postgres-host.railway.app:5432/database?sslmode=require"
DATABASE_POOL_SIZE="1"
DATABASE_IDLE_TIMEOUT_SECONDS="20"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# Server-only AWS Lambda secret references
DATABASE_SECRET_ID="barbarotech/portal/database-url"
DATABASE_SSM_PARAMETER_NAME=""
STRIPE_SECRET_ID="barbarotech/portal/stripe"
STRIPE_SECRET_KEY_SSM_PARAMETER_NAME=""
STRIPE_WEBHOOK_SECRET_ID=""
STRIPE_WEBHOOK_SECRET_SSM_PARAMETER_NAME=""

# Server-only Stripe values for local API tests/development
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"

# Server-only portal API values
ADMIN_EMAIL="anthony@barbaro.tech"
ADMIN_COGNITO_SUB="cognito-sub-for-anthony"
COGNITO_USER_POOL_ID="us-west-1_replace_me"
REQUEST_UPLOAD_BUCKET="barbarotech-request-uploads-dev"
PORTAL_RETURN_URL="http://localhost:3000/portal/billing/"
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/portal/billing/"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/portal/billing/"
