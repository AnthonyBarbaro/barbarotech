# Contact form availability
# Static exports always disable contact and call-request submissions.
CONTACT_INTAKE_ENABLED=true
NEXT_PUBLIC_CONTACT_INTAKE_ENABLED=false
STATIC_EXPORT=false

# SMTP connection
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Email addresses
# CONTACT_FROM falls back to SMTP_FROM, then SMTP_USER.
SMTP_FROM=no-reply@example.com
CONTACT_FROM=no-reply@example.com
# CONTACT_TO falls back to SMTP_USER; CALL_TO falls back to CONTACT_TO.
CONTACT_TO=contact@example.com
CALL_TO=contact@example.com
